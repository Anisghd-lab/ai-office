# AI Office Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to source control!

# Backend Network & Execution Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
SECRET_KEY=change-this-in-production-to-a-random-secure-string-min-32-chars

# Timezone
TIMEZONE=Africa/Algiers

# Database Settings
DATABASE_PATH=backend/app/database/storage/ai_office.db
DATABASE_WAL_MODE=true

# Security & CEO Gateway
CEO_APPROVAL_TOKEN_TTL_SECONDS=1800
CEO_GATEWAY_DEFAULT_DENY=true
ENCRYPTION_KEY_32BYTES_BASE64=

# Free Tier AI Provider Configurations (Fill with your legitimately obtained free keys)
# Groq (Free tier available)
GROQ_API_KEY=
# Google Gemini (Free tier available)
GEMINI_API_KEY=
# OpenRouter (Free model tier available)
OPENROUTER_API_KEY=
# Hugging Face (Free inference API)
HUGGINGFACE_API_KEY=
# Local / Ollama / OpenAI-compatible endpoint
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_OPENAI_API_KEY=dummy-free-key

# Social Media OAuth (TikTok, Facebook, Instagram)
# Obtain these free developer credentials from the official platform developer portals
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/social/tiktok/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/social/facebook/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/v1/social/instagram/callback
